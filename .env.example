# Server-only. NEVER prefix with VITE_.
# Lấy key miễn phí: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model chính. Nếu 404, server tự thử: gemini-flash-latest → gemini-2.5-flash → gemini-2.5-flash-lite
GEMINI_MODEL=gemini-3.6-flash

# Port server Node (Nginx sẽ trỏ vào port này)
PORT=3000

# (Tuỳ chọn) Đổi endpoint Gemini — chỉ dùng khi test với mock (scripts/mock-gemini.js)
# GEMINI_API_ROOT=https://generativelanguage.googleapis.com/v1beta
